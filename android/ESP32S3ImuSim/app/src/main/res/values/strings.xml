    <string name="floor_calib_status_none">Not calibrated</string>
    <string name="floor_calib_result_none">No correction stored — raw mounting tilt is used as-is.</string>

    <string name="ahrs_menu">AHRS live view (full speed)…</string>
    <string name="ahrs_title">AHRS — live orientation</string>
    <string name="ahrs_help">On-device attitude filter (complementary filter, gyro+accel, no magnetometer — yaw drifts over time). Separated from the other modes because it forces full CPU clock (240 MHz) and max IMU sample rate (100 Hz) for the smoothest fusion — this is NOT a battery saver. Speed reverts to Auto when you leave this screen. For a 3D cube view, open the web debug page from the dashboard.</string>

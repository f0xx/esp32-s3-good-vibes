/*
 * Waveshare ESP32-S3-LCD-1.47B (rev B3) PROCPU
 */

/dts-v1/;
#include <espressif/esp32s3/esp32s3_wroom_n8r8.dtsi>
#include "esp32s3_lcd_147b-pinctrl.dtsi"
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "Waveshare ESP32-S3-LCD-1.47B PROCPU";
	compatible = "waveshare,esp32-s3-lcd-1.47b";

	aliases {
		i2c-0 = &i2c0;
		sw0 = &button0;
		watchdog0 = &wdt0;
		lcd-backlight = &lcd_backlight;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,display = &st7789v;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,settings-partition = &storage_partition;
	};

	zephyr,user {
		io-channels = <&adc0 0>; /* GPIO1 = IDF ADC1 CH0 */
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "BOOT Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		lcd_backlight: lcd_backlight {
			label = "LCD Backlight";
			pwms = <&ledc0 0 PWM_KHZ(1) PWM_POLARITY_NORMAL>;
		};
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;   /* GPIO41 */
		reset-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>; /* GPIO39 */
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st7789v: st7789v@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			/* GPIO-matrix SPI2 (CLK 40 / MOSI 45 / CS 42), not the FSPI
			 * IO_MUX pins. Matrix routing is specified to 20 MHz;
			 * 40 MHz here double-faulted the PRO CPU (invalid SP). */
			mipi-max-frequency = <20000000>;
			width = <172>;
			height = <320>;
			x-offset = <34>;
			y-offset = <0>;
			vcom = <0x28>;
			gctrl = <0x35>;
			vrhs = <0x10>;
			vdvs = <0x20>;
			mdac = <0x00>;
			gamma = <0x01>;
			colmod = <0x55>;
			lcm = <0x0c>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 00];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 00 02 07 0a 28 32 44 42 06 0e 12 14 17];
			nvgam-param = [d0 00 02 07 0a 28 31 54 47 0e 1c 17 1b 1e];
			ram-param = [00 E0];
			rgb-param = [40 02 14];
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		};
	};
};

&flash0 {
	status = "okay";
	reg = <0x0 DT_SIZE_M(16)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x00010000>;
			read-only;
		};

		/* 3 MiB slots so a desk -Og image fits. 16 MB flash; the tail
		 * (scratch/NVS/coredump/appdata) moved up. A USB reflash is
		 * required — old absolute NVS/appdata offsets are not reused. */
		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x00010000 0x00300000>;
		};

		slot1_partition: partition@310000 {
			label = "image-1";
			reg = <0x00310000 0x00300000>;
		};

		/* McUboot SWAP_USING_SCRATCH only — never store app data here. */
		scratch_partition: partition@610000 {
			label = "image-scratch";
			reg = <0x00610000 0x00040000>;
		};

		storage_partition: partition@650000 {
			label = "storage";
			reg = <0x00650000 0x00008000>;
		};

		coredump_partition: partition@658000 {
			label = "coredump-partition";
			reg = <0x00658000 DT_SIZE_K(16)>;
		};

		/* Survives OTA: vibro refs, crash ring, verdict spool (was wrongly on scratch). */
		appdata_partition: partition@65c000 {
			label = "app-data";
			reg = <0x0065c000 0x00040000>;
		};
	};
};

&usb_serial {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	scl-timeout-us = <20000>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

&spi2 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>; /* GPIO42 */
};

&spi3 {
	status = "disabled";
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};

/* GPIO1 battery sense: IDF ADC_UNIT_1 (= Zephyr adc0), not adc1 (ADC2). */
&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&adc1 {
	status = "disabled";
};

&coretemp {
	status = "okay";
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&timer0 {
	status = "okay";
};
